  "main": "src/main.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "bot": "node --env-file-if-exists=.env src/bot.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "discord.js": "^14.18.0"
  },
  "devDependencies": {
    "zod": "^4.6.7"
  }
}
