# Everything here can also be set in the web dashboard (http://<this machine>:3080), which is the easier way.
# Values saved in the dashboard override this file.

# Dashboard
WEB_PORT=3080
# 0.0.0.0 = reachable from your network. 127.0.0.1 = this machine only (e.g. behind a reverse proxy).
WEB_HOST=0.0.0.0

# Discord (discord.com/developers → your app → Bot)
DISCORD_BOT_TOKEN=

# Personality and behaviour
BOT_NAME=Yapper
BOT_PERSONA=
BOT_STATUS=Mention me to chat
# Channel IDs where it answers every message (it always answers @mentions and replies).
BOT_CHANNELS=
BOT_DMS=on
BOT_MEMORY=20
# off = no /ask, /reset, /about (people chat by @mentioning only)
BOT_SLASH_COMMANDS=on

# AI: anthropic | claude-cli | openai | codex-cli | gemini | gemini-cli | opencode | local | custom
AI_PROVIDER=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_FALLBACK_MODEL=
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen2.5:7b
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
# on = use the local model when the main AI fails
AI_LOCAL_FALLBACK=off


# Discord tools (https://github.com/SaseQ/discord-mcp): lets the AI act in the server when asked
DISCORD_TOOLS=off
DISCORD_TOOLS_URL=http://127.0.0.1:8085/mcp
# read = look things up only, full = also send, edit, manage and moderate
DISCORD_TOOLS_ACCESS=read
# admins = people with Manage Server permission, or everyone
DISCORD_TOOLS_WHO=admins

# STORAGE_DIR=./storage
